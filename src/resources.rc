1 ICON "assets/app.ico"
1 24 "assets/app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Windows 10 Native File Encryption and Secure Shredder"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "win10_file_enc"
            VALUE "LegalCopyright", "Open Source"
            VALUE "OriginalFilename", "win10_file_enc.exe"
            VALUE "ProductName", "Win10 File Encryptor"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
